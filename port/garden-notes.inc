/* Dream as MIDI (0.12): every note the engine plays goes out through the host's MIDI (SDK 9) –
 * tracks 1-6 on channels 1-6, the lo-fi kit on channel 10 (GM drums from note 36). A DAW records the
 * generative music as MIDI, an external synth can double a track. Off by default.
 * Audio side, once per block: the engine's per-track event counters say what was just played. */
enum { NOTE_GATE = 15435 };                   /* 0.35 s at the engine's 44.1 kHz, or until the next note */
static uint32_t notes_seen[MD_TRACKS];
static uint8_t notes_held[MD_TRACKS], notes_channel[MD_TRACKS];
static unsigned notes_age[MD_TRACKS];
static int notes_biome = -1, notes_playing, notes_kit;

static int notes_off_track(unsigned i) {
    if (!notes_held[i]) return 1;
    if (vibe_midi_send((uint8_t)(0x80 | notes_channel[i]), notes_held[i], 0) != 0) {
        notes_age[i] = NOTE_GATE;      /* retry next block; never forget an unaccepted Note-Off */
        return 0;
    }
    notes_held[i] = 0;
    return 1;
}

static void notes_all_off(void) {
    const md_stats *st = md_status();
    for (unsigned i = 0; i < MD_TRACKS; i++) { notes_off_track(i); notes_seen[i] = st->events[i]; }
}

static void notes_init(void) {
    notes_all_off();
    notes_biome = md_state()->biome_id;
    notes_playing = md_playing();
    notes_kit = md_state()->kit.enabled;
}

static void notes_out_tick(unsigned frames, const uint32_t before[MD_TRACKS]) {
    const md_stats *st = md_status();
    const md_patch *p = md_state();
    const int playing = md_playing();
    if (notes_playing && !playing) notes_all_off();
    notes_playing = playing;
    if (p->biome_id != notes_biome) {
        for (unsigned i = 0; i < MD_TRACKS; i++) { notes_off_track(i); notes_seen[i] = before[i]; }
        /* Discard old pending events; retain first notes generated by the new Biome in this render. */
        notes_biome = p->biome_id;
    }
    if (p->kit.enabled != notes_kit) {
        for (unsigned i = 3; i < MD_TRACKS; i++) { notes_off_track(i); notes_seen[i] = before[i]; }
        notes_kit = p->kit.enabled;
    }
    if (!settings.notes_out) {
        notes_all_off();
        return;
    }
    for (unsigned i = 0; i < MD_TRACKS; i++) {
        if (p->track[i].mute || (p->kit.enabled && i >= 4)) {
            notes_off_track(i); notes_seen[i] = st->events[i]; continue;
        }
        const int kit = p->kit.enabled && i == 3;
        const uint8_t channel = (uint8_t)(kit ? 9 : i);
        if (notes_held[i] && notes_channel[i] != channel) {
            notes_seen[i] = before[i]; /* do not replay pending synth events on the new kit channel */
            if (!notes_off_track(i)) continue;
        }
        if (notes_held[i]) {
            if (notes_age[i] < NOTE_GATE) notes_age[i] += frames;
            if (notes_age[i] >= NOTE_GATE && !notes_off_track(i)) continue;
        }
        if (st->events[i] == notes_seen[i]) continue;
        int note = st->last_note[i];
        if (note < 1) note = kit ? 36 : 60;
        if (note > 127) note = 127;
        if (!notes_off_track(i)) continue;
        const int velocity = 40 + p->track[i].level * 80 / 1000;
        if (vibe_midi_send((uint8_t)(0x90 | channel), (uint8_t)note, (uint8_t)(velocity > 127 ? 127 : velocity)) == 0) {
            notes_channel[i] = channel; notes_held[i] = (uint8_t)note; notes_age[i] = 0;
            notes_seen[i] = st->events[i];
        }
    }
}
